{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "get_order response",
  "type": "object",
  "required": ["order_id", "status", "order_total", "days_since_delivery"],
  "properties": {
    "order_id": {"type": "string"},
    "status": {"type": "string", "enum": ["delivered", "processing", "cancelled"]},
    "order_total": {"type": "number"},
    "days_since_delivery": {"type": "integer", "minimum": 0},
    "currency": {"type": "string"},
    "tool_notice": {"type": "string"}
  },
  "additionalProperties": true
}
